<UserControl x:Class="MacWin.Settings.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MacWin.Settings.Controls">
    <StackPanel>
        <StackPanel HorizontalAlignment="Center" Margin="0,10,0,26">
            <c:AppIcon Width="96" Height="96" HorizontalAlignment="Center"/>
            <TextBlock Style="{StaticResource Text.LargeTitle}" Text="MacWin" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            <TextBlock x:Name="VersionText" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <TextBlock Text="Animacje okien w stylu macOS dla Windows 11" HorizontalAlignment="Center" Margin="0,8,0,0"
                       Foreground="{DynamicResource Brush.TextSecondary}"/>
        </StackPanel>

        <TextBlock Style="{StaticResource Text.GroupHeader}" Text="Autorzy i licencje"/>
        <Border Style="{StaticResource Group}">
            <StackPanel>
                <c:SettingRow Title="Animacja dżina"
                              Description="Na podstawie moda „MacOS Minimize Animation” do Windhawka – Abdullah Masood, z silnikiem Potassiumunchera. Licencja MIT."/>
                <Rectangle Style="{StaticResource RowSeparator}"/>
                <c:SettingRow Title="MinHook" Description="Biblioteka podpinania funkcji – Tsuda Kageyu. Licencja BSD-2."/>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Text.GroupHeader}" Text="Pliki"/>
        <Border Style="{StaticResource Group}">
            <StackPanel>
                <c:SettingRow Title="Dziennik działania" Description="Co MacWin robi: animacje, czasy klatek, błędy.">
                    <Button Style="{StaticResource MacButton}" Content="Otwórz" Click="OpenLog_Click"/>
                </c:SettingRow>
                <Rectangle Style="{StaticResource RowSeparator}"/>
                <c:SettingRow Title="Folder ustawień" Description="settings.json – to samo, co zmieniasz w tym oknie.">
                    <Button Style="{StaticResource MacButton}" Content="Pokaż" Click="OpenFolder_Click"/>
                </c:SettingRow>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
