<UserControl x:Class="MacWin.Settings.Pages.CornersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MacWin.Settings.Controls"
             xmlns:l="clr-namespace:MacWin.Settings">
    <StackPanel>
        <!-- Preview: a window with the chosen corners and shadow (never mirrored) -->
        <Border Style="{StaticResource Group}" Padding="0" ClipToBounds="True" FlowDirection="LeftToRight">
            <Border x:Name="PreviewBackdrop" Height="200" CornerRadius="9" ClipToBounds="True"
                    SizeChanged="Preview_SizeChanged">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF2B3A67" Offset="0"/>
                        <GradientStop Color="#FF7A4E8C" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Canvas x:Name="PreviewCanvas">
                    <Path x:Name="PreviewShadow" Fill="Black">
                        <Path.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="7" Direction="270" Opacity="0.45"/>
                        </Path.Effect>
                    </Path>
                    <Path x:Name="PreviewWindow" Fill="{DynamicResource Brush.WindowBase}"
                          Stroke="#4D000000" StrokeThickness="1"/>
                    <Path x:Name="PreviewTitle" Fill="{DynamicResource Brush.Sidebar}"/>
                </Canvas>
            </Border>
        </Border>

        <TextBlock Style="{StaticResource Text.GroupHeader}" Text="{l:Tr settings.corners.shape.header}"/>
        <Border Style="{StaticResource Group}">
            <StackPanel>
                <c:SettingRow Title="{l:Tr settings.corners.shape.title}"
                              Description="{l:Tr settings.corners.shape.description}">
                    <c:SegmentedControl MinWidth="230" ItemKeys="settings.corners.shape.windows11|settings.corners.shape.macos"
                                        SelectedIndex="{Binding CornerShape, Mode=TwoWay}"/>
                </c:SettingRow>
                <Rectangle Style="{StaticResource RowSeparator}"/>
                <c:SettingRow Title="{l:Tr settings.corners.radius.title}" Description="{l:Tr settings.corners.radius.description}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Style="{StaticResource MacSlider}" Width="190" Minimum="0" Maximum="30"
                                TickFrequency="1" SmallChange="1" LargeChange="4" Value="{Binding CornerRadius}"/>
                        <TextBlock MinWidth="{l:UnitWidth settings.unit.ms}" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="{Binding CornerRadius, Converter={StaticResource Unit.Px}}"/>
                    </StackPanel>
                </c:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Text.GroupHeader}" Text="{l:Tr settings.corners.where.header}"/>
        <Border Style="{StaticResource Group}">
            <StackPanel>
                <c:SettingRow Title="{l:Tr settings.corners.genie.title}"
                              Description="{l:Tr settings.corners.genie.description}">
                    <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center"
                               Text="{l:Tr settings.corners.always}"/>
                </c:SettingRow>
                <Rectangle Style="{StaticResource RowSeparator}"/>
                <c:SettingRow Title="{l:Tr settings.corners.others.title}"
                              Description="{l:Tr settings.corners.others.description}">
                    <CheckBox Style="{StaticResource MacSwitch}" IsChecked="{Binding WindowCorners}"/>
                </c:SettingRow>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
