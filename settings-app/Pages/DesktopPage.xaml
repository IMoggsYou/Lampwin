<UserControl x:Class="MacWin.Settings.Pages.DesktopPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MacWin.Settings.Controls"
             xmlns:l="clr-namespace:MacWin.Settings">
    <UserControl.Resources>
        <!-- The same list for every corner (settings.desktop.action.*, SettingsModel.CornerActionNames) -->
        <Style x:Key="CornerBox" TargetType="ComboBox" BasedOn="{StaticResource MacComboBox}">
            <Setter Property="Width" Value="220"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <!-- Window overview -->
        <Border Style="{StaticResource Group}">
            <StackPanel>
                <c:SettingRow Title="{l:Tr settings.desktop.overview.title}"
                              Description="{l:Tr settings.desktop.overview.description}">
                    <Button Style="{StaticResource MacButton}" Content="{l:Tr settings.desktop.overview.show}"
                            Click="ShowOverview_Click"/>
                </c:SettingRow>
                <Rectangle Style="{StaticResource RowSeparator}"/>
                <c:SettingRow Title="{l:Tr settings.desktop.overview.hotkey.title}"
                              Description="{l:Tr settings.desktop.overview.hotkey.description}">
                    <CheckBox Style="{StaticResource MacSwitch}" IsChecked="{Binding OverviewHotkey}"/>
                </c:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Text.GroupHeader}" Text="{l:Tr settings.desktop.corners.header}"/>
        <Border Style="{StaticResource Group}">
            <StackPanel>
                <c:SettingRow Title="{l:Tr settings.desktop.corners.topLeft}">
                    <ComboBox x:Name="TopLeftBox" Style="{StaticResource CornerBox}"
                              SelectedIndex="{Binding CornerTopLeft, Mode=TwoWay}"/>
                </c:SettingRow>
                <Rectangle Style="{StaticResource RowSeparator}"/>
                <c:SettingRow Title="{l:Tr settings.desktop.corners.topRight}">
                    <ComboBox x:Name="TopRightBox" Style="{StaticResource CornerBox}"
                              SelectedIndex="{Binding CornerTopRight, Mode=TwoWay}"/>
                </c:SettingRow>
                <Rectangle Style="{StaticResource RowSeparator}"/>
                <c:SettingRow Title="{l:Tr settings.desktop.corners.bottomLeft}">
                    <ComboBox x:Name="BottomLeftBox" Style="{StaticResource CornerBox}"
                              SelectedIndex="{Binding CornerBottomLeft, Mode=TwoWay}"/>
                </c:SettingRow>
                <Rectangle Style="{StaticResource RowSeparator}"/>
                <c:SettingRow Title="{l:Tr settings.desktop.corners.bottomRight}">
                    <ComboBox x:Name="BottomRightBox" Style="{StaticResource CornerBox}"
                              SelectedIndex="{Binding CornerBottomRight, Mode=TwoWay}"/>
                </c:SettingRow>
            </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource Text.Footnote}" Text="{l:Tr settings.desktop.corners.footnote}"/>

        <TextBlock Style="{StaticResource Text.GroupHeader}" Text="{l:Tr settings.desktop.appearance.header}"/>
        <Border Style="{StaticResource Group}">
            <StackPanel>
                <c:SettingRow Title="{l:Tr settings.desktop.darkMode.title}"
                              Description="{l:Tr settings.desktop.darkMode.description}">
                    <CheckBox Style="{StaticResource MacSwitch}" IsChecked="{Binding DarkModeSchedule}"/>
                </c:SettingRow>
                <Rectangle Style="{StaticResource RowSeparator}"/>
                <c:SettingRow Title="{l:Tr settings.desktop.wallpaper.title}"
                              Description="{l:Tr settings.desktop.wallpaper.description}">
                    <CheckBox Style="{StaticResource MacSwitch}" IsChecked="{Binding WallpaperSchedule}"/>
                </c:SettingRow>
                <Rectangle Style="{StaticResource RowSeparator}"/>
                <c:SettingRow Title="{l:Tr settings.desktop.wallpaper.day}" Description="{Binding DayWallpaperName}"
                              IsEnabled="{Binding WallpaperSchedule}">
                    <Button Style="{StaticResource MacButton}" Content="{l:Tr settings.desktop.wallpaper.choose}"
                            Click="ChooseDay_Click"/>
                </c:SettingRow>
                <Rectangle Style="{StaticResource RowSeparator}"/>
                <c:SettingRow Title="{l:Tr settings.desktop.wallpaper.night}" Description="{Binding NightWallpaperName}"
                              IsEnabled="{Binding WallpaperSchedule}">
                    <Button Style="{StaticResource MacButton}" Content="{l:Tr settings.desktop.wallpaper.choose}"
                            Click="ChooseNight_Click"/>
                </c:SettingRow>
                <Rectangle Style="{StaticResource RowSeparator}"/>
                <c:SettingRow Title="{l:Tr settings.desktop.schedule.title}" IsEnabled="{Binding HasSchedule}"
                              Description="{l:Tr settings.desktop.schedule.description}">
                    <c:SegmentedControl MinWidth="230" ItemKeys="settings.desktop.schedule.sun|settings.desktop.schedule.times"
                                        SelectedIndex="{Binding ScheduleIndex, Mode=TwoWay}"/>
                </c:SettingRow>
                <Rectangle Style="{StaticResource RowSeparator}"/>
                <c:SettingRow Title="{l:Tr settings.desktop.dayStart.title}" IsEnabled="{Binding HasSchedule}"
                              Description="{l:Tr settings.desktop.dayStart.description}">
                    <TextBox Style="{StaticResource MacTextBox}" Width="70" Height="26" TextAlignment="Center"
                             FlowDirection="LeftToRight" Text="{Binding DayStart, Mode=TwoWay}"/>
                </c:SettingRow>
                <Rectangle Style="{StaticResource RowSeparator}"/>
                <c:SettingRow Title="{l:Tr settings.desktop.nightStart.title}" IsEnabled="{Binding HasSchedule}">
                    <TextBox Style="{StaticResource MacTextBox}" Width="70" Height="26" TextAlignment="Center"
                             FlowDirection="LeftToRight" Text="{Binding NightStart, Mode=TwoWay}"/>
                </c:SettingRow>
            </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource Text.Footnote}" Text="{l:Tr settings.desktop.appearance.footnote}"/>
    </StackPanel>
</UserControl>
