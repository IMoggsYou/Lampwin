<UserControl x:Class="MacWin.Settings.Pages.ExclusionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MacWin.Settings.Controls"
             xmlns:l="clr-namespace:MacWin.Settings">
    <StackPanel>
        <TextBlock Style="{StaticResource Text.GroupHeader}" Text="{l:Tr settings.exclusions.noAnimation.header}"/>
        <Border Style="{StaticResource Group}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Secondary}" Margin="14,12,14,6"
                           Text="{l:Tr settings.exclusions.noAnimation.description}"/>
                <c:ProgramList Items="{Binding Excluded}"/>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Text.GroupHeader}" Text="{l:Tr settings.exclusions.noInject.header}"/>
        <Border Style="{StaticResource Group}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Secondary}" Margin="14,12,14,6"
                           Text="{l:Tr settings.exclusions.noInject.description}"/>
                <c:ProgramList Items="{Binding NoInject}"/>
                <!-- Puts back the games MacWin protects by default (kept: everything else) -->
                <Button x:Name="RestoreDefaults" Style="{StaticResource MacButton}" HorizontalAlignment="Right"
                        Margin="14,-4,14,14" Padding="12,3" Content="{l:Tr settings.exclusions.noInject.restore}"
                        Click="RestoreDefaults_Click"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
