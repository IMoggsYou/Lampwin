<UserControl x:Class="MacWin.Settings.Pages.AnimationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MacWin.Settings.Controls"
             xmlns:l="clr-namespace:MacWin.Settings">
    <StackPanel>
        <!-- Live preview (a picture of a desktop: never mirrored for right-to-left languages) -->
        <Border Style="{StaticResource Group}" Padding="0" ClipToBounds="True" FlowDirection="LeftToRight">
            <Grid>
                <Border c:RoundClip.Radius="9">
                    <c:GeniePreview x:Name="Preview" Height="240" GenieStyle="{Binding Style}" DurationMs="{Binding DurationMs}"
                                    Tiles="{Binding MeshQuality}" CornerRadiusPx="{Binding CornerRadius}"
                                    CornerSmoothing="{Binding CornerSmoothing}" CloseDurationMs="{Binding CloseDurationMs}"
                                    OpenDurationMs="{Binding OpenDurationMs}"/>
                </Border>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" CornerRadius="6" Padding="8,3"
                        Background="#59000000" IsHitTestVisible="False">
                    <TextBlock Text="{l:Tr settings.animations.preview.hint}" FontSize="11" Foreground="White"
                               FlowDirection="{x:Static l:Loc.FlowDirection}"/>
                </Border>
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource Text.GroupHeader}" Text="{l:Tr settings.animations.appearance}"/>
        <Border Style="{StaticResource Group}">
            <StackPanel>
                <!-- Three styles: the choice gets the row's full width, under its description -->
                <c:SettingRow Title="{l:Tr settings.animations.style.title}" Description="{Binding StyleDescription}"/>
                <c:SegmentedControl Margin="14,0,14,12"
                                    ItemKeys="settings.animations.style.modern|settings.animations.style.classic|settings.animations.style.scale"
                                    SelectedIndex="{Binding Style, Mode=TwoWay}"/>
                <Rectangle Style="{StaticResource RowSeparator}"/>
                <c:SettingRow Title="{l:Tr settings.animations.duration.title}"
                              Description="{l:Tr settings.animations.duration.description}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Style="{StaticResource MacSlider}" Width="190" Minimum="100" Maximum="1500"
                                TickFrequency="10" SmallChange="10" LargeChange="100" Value="{Binding DurationMs}"/>
                        <TextBlock MinWidth="{l:UnitWidth settings.unit.ms}" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="{Binding DurationMs, Converter={StaticResource Unit.Ms}}"/>
                    </StackPanel>
                </c:SettingRow>
                <Rectangle Style="{StaticResource RowSeparator}"/>
                <c:SettingRow Title="{l:Tr settings.animations.mesh.title}" IsEnabled="{Binding IsModern}"
                              Description="{l:Tr settings.animations.mesh.description}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Style="{StaticResource MacSlider}" Width="190" Minimum="8" Maximum="96"
                                TickFrequency="1" SmallChange="1" LargeChange="8" Value="{Binding MeshQuality}"/>
                        <TextBlock MinWidth="{l:UnitWidth settings.unit.ms}" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="{Binding MeshQuality, StringFormat={}{0:0}}"/>
                    </StackPanel>
                </c:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Text.GroupHeader}" Text="{l:Tr settings.animations.openClose.header}"/>
        <Border Style="{StaticResource Group}">
            <StackPanel>
                <c:SettingRow Title="{l:Tr settings.animations.open.title}" Description="{Binding OpenDescription}">
                    <c:SegmentedControl MinWidth="380"
                                        ItemKeys="settings.animations.effect.windows|settings.animations.effect.genie|settings.animations.effect.shatter|settings.animations.effect.fragments"
                                        SelectedIndex="{Binding OpenEffect, Mode=TwoWay}"/>
                </c:SettingRow>
                <Rectangle Style="{StaticResource RowSeparator}"/>
                <c:SettingRow Title="{l:Tr settings.animations.openDuration.title}" IsEnabled="{Binding HasOpenEffect}"
                              Description="{l:Tr settings.animations.openDuration.description}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Style="{StaticResource MacSlider}" Width="190" Minimum="150" Maximum="1000"
                                TickFrequency="10" SmallChange="10" LargeChange="50" Value="{Binding OpenDurationMs}"/>
                        <TextBlock MinWidth="{l:UnitWidth settings.unit.ms}" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="{Binding OpenDurationMs, Converter={StaticResource Unit.Ms}}"/>
                    </StackPanel>
                </c:SettingRow>
                <Rectangle Style="{StaticResource RowSeparator}"/>
                <c:SettingRow Title="{l:Tr settings.animations.close.title}" Description="{Binding CloseDescription}">
                    <c:SegmentedControl MinWidth="380"
                                        ItemKeys="settings.animations.effect.windows|settings.animations.effect.genie|settings.animations.effect.shatter|settings.animations.effect.fragments"
                                        SelectedIndex="{Binding CloseEffect, Mode=TwoWay}"/>
                </c:SettingRow>
                <Rectangle Style="{StaticResource RowSeparator}"/>
                <c:SettingRow Title="{l:Tr settings.animations.closeDuration.title}" IsEnabled="{Binding HasCloseEffect}"
                              Description="{l:Tr settings.animations.closeDuration.description}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Style="{StaticResource MacSlider}" Width="190" Minimum="100" Maximum="800"
                                TickFrequency="10" SmallChange="10" LargeChange="50" Value="{Binding CloseDurationMs}"/>
                        <TextBlock MinWidth="{l:UnitWidth settings.unit.ms}" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="{Binding CloseDurationMs, Converter={StaticResource Unit.Ms}}"/>
                    </StackPanel>
                </c:SettingRow>
            </StackPanel>
        </Border>
        <Grid Margin="6,-6,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,16,0"
                       Text="{l:Tr settings.animations.openClose.note}"/>
            <Button Grid.Column="1" Style="{StaticResource MacButton}" VerticalAlignment="Center"
                    Content="{l:Tr settings.animations.tryOpenClose}" Click="TryOpenClose_Click"/>
        </Grid>

        <TextBlock Style="{StaticResource Text.GroupHeader}" Text="{l:Tr settings.animations.when.header}"/>
        <Border Style="{StaticResource Group}">
            <StackPanel>
                <c:SettingRow Title="{l:Tr settings.animations.restore.title}"
                              Description="{l:Tr settings.animations.restore.description}">
                    <CheckBox Style="{StaticResource MacSwitch}" IsChecked="{Binding Restore}"/>
                </c:SettingRow>
                <Rectangle Style="{StaticResource RowSeparator}"/>
                <c:SettingRow Title="{l:Tr settings.animations.multiMonitor.title}"
                              Description="{l:Tr settings.animations.multiMonitor.description}">
                    <CheckBox Style="{StaticResource MacSwitch}" IsChecked="{Binding MultiMonitor}"/>
                </c:SettingRow>
                <Rectangle Style="{StaticResource RowSeparator}"/>
                <c:SettingRow Title="{l:Tr settings.animations.followSystem.title}"
                              Description="{l:Tr settings.animations.followSystem.description}">
                    <CheckBox Style="{StaticResource MacSwitch}" IsChecked="{Binding FollowSystemMotion}"/>
                </c:SettingRow>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Text.GroupHeader}" Text="{l:Tr settings.animations.autoHide.header}"/>
        <Border Style="{StaticResource Group}">
            <StackPanel>
                <c:SettingRow Title="{l:Tr settings.animations.unhide.title}"
                              Description="{l:Tr settings.animations.unhide.description}">
                    <CheckBox Style="{StaticResource MacSwitch}" IsChecked="{Binding UnhideTaskbar}"/>
                </c:SettingRow>
                <Rectangle Style="{StaticResource RowSeparator}"/>
                <c:SettingRow Title="{l:Tr settings.animations.unhideDuration.title}" IsEnabled="{Binding UnhideTaskbar}">
                    <StackPanel Orientation="Horizontal">
                        <Slider Style="{StaticResource MacSlider}" Width="190" Minimum="0" Maximum="3000"
                                TickFrequency="50" SmallChange="50" LargeChange="250" Value="{Binding UnhideDurationMs}"/>
                        <TextBlock MinWidth="{l:UnitWidth settings.unit.ms}" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="{Binding UnhideDurationMs, Converter={StaticResource Unit.Ms}}"/>
                    </StackPanel>
                </c:SettingRow>
            </StackPanel>
        </Border>

        <Grid Margin="6,-6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,16,0"
                       Text="{l:Tr settings.animations.instant.note}"/>
            <Button Grid.Column="1" Style="{StaticResource MacButton}" VerticalAlignment="Center"
                    Content="{l:Tr settings.animations.tryReal}" Click="TryReal_Click"/>
        </Grid>
    </StackPanel>
</UserControl>
