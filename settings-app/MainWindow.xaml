<Window x:Class="MacWin.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MacWin.Settings.Controls"
        Width="880" Height="640" MinWidth="740" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        FontFamily="{DynamicResource Font.Text}" FontSize="13" Foreground="{DynamicResource Brush.Text}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" GlassFrameThickness="0" ResizeBorderThickness="6"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Frame">
    <!-- Alpha 1/255: invisible, but the corners cut off by the squircle still take the
         mouse, so the window can be resized from them. -->
    <Rectangle Fill="#01000000"/>
    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" Background="{DynamicResource Brush.WindowBase}"
          SizeChanged="Root_SizeChanged">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale"/>
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar (translucent over Mica) -->
        <Grid Background="{DynamicResource Brush.Sidebar}">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <c:TrafficLights Margin="20,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBox x:Name="Search" Grid.Row="1" Margin="12,0,12,12" Height="28" Style="{StaticResource SearchBox}"
                     TextChanged="Search_TextChanged"/>
            <ListBox x:Name="Nav" Grid.Row="2" Margin="10,0" Style="{StaticResource SidebarList}"
                     ItemContainerStyle="{StaticResource SidebarItem}" SelectionChanged="Nav_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Border Width="22" Height="22" CornerRadius="5.5" Background="{Binding Tint}">
                                <Path Data="{Binding Icon}" Fill="White" Stretch="Uniform" Width="12" Height="12"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" Margin="9,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border x:Name="StatusPill" Grid.Row="3" Margin="12" Padding="10,7" CornerRadius="8"
                    Background="{DynamicResource Brush.SidebarHover}" MouseLeftButtonUp="StatusPill_Click">
                <DockPanel>
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                </DockPanel>
            </Border>
        </Grid>
        <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right" Fill="{DynamicResource Brush.Separator}"/>

        <!-- Content -->
        <Grid Grid.Column="1" Background="{DynamicResource Brush.WindowBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="PageTitle" Margin="30,0,30,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                       FontFamily="{DynamicResource Font.Display}" TextTrimming="CharacterEllipsis"/>
            <ScrollViewer x:Name="Scroller" Grid.Row="1" Style="{StaticResource MacScrollViewer}"
                          VerticalScrollBarVisibility="Auto" c:SmoothScroll.Enabled="True">
                <ContentControl x:Name="PageHost" Margin="30,6,30,30" MaxWidth="660" Focusable="False">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="PageShift"/>
                    </ContentControl.RenderTransform>
                </ContentControl>
            </ScrollViewer>
        </Grid>

        <c:UpdateSheet x:Name="UpdateSheet" Grid.ColumnSpan="2"/>
        <c:WelcomeSheet x:Name="WelcomeSheet" Grid.ColumnSpan="2"/>

        <!-- Hairline along the squircle edge (Root's clip keeps its inner half). -->
        <Path x:Name="Outline" Grid.ColumnSpan="2" StrokeThickness="2" IsHitTestVisible="False"
              Stroke="{DynamicResource Brush.WindowOutline}"/>
    </Grid>
    </Grid>
</Window>
