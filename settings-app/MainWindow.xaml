<Window x:Class="MacWin.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MacWin.Settings.Controls"
        Width="880" Height="640" MinWidth="740" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="Transparent"
        FontFamily="{StaticResource Font.Text}" FontSize="13" Foreground="{DynamicResource Brush.Text}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" GlassFrameThickness="-1" ResizeBorderThickness="6"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale"/>
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar (translucent over Mica) -->
        <Grid Background="{DynamicResource Brush.Sidebar}">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <c:TrafficLights Margin="20,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBox x:Name="Search" Grid.Row="1" Margin="12,0,12,12" Height="28" Style="{StaticResource SearchBox}"
                     Tag="Szukaj" TextChanged="Search_TextChanged"/>
            <ListBox x:Name="Nav" Grid.Row="2" Margin="10,0" Style="{StaticResource SidebarList}"
                     ItemContainerStyle="{StaticResource SidebarItem}" SelectionChanged="Nav_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="5.5" Background="{Binding Tint}">
                                <Path Data="{Binding Icon}" Fill="White" Stretch="Uniform" Width="12" Height="12"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border x:Name="StatusPill" Grid.Row="3" Margin="12" Padding="10,7" CornerRadius="8"
                    Background="{DynamicResource Brush.SidebarHover}" MouseLeftButtonUp="StatusPill_Click">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                </StackPanel>
            </Border>
        </Grid>
        <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right" Fill="{DynamicResource Brush.Separator}"/>

        <!-- Content -->
        <Grid Grid.Column="1" Background="{DynamicResource Brush.WindowBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="PageTitle" Margin="30,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                       FontFamily="{StaticResource Font.Display}"/>
            <ScrollViewer x:Name="Scroller" Grid.Row="1" Style="{StaticResource MacScrollViewer}"
                          VerticalScrollBarVisibility="Auto" c:SmoothScroll.Enabled="True">
                <ContentControl x:Name="PageHost" Margin="30,6,30,30" MaxWidth="660" Focusable="False">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="PageShift"/>
                    </ContentControl.RenderTransform>
                </ContentControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
