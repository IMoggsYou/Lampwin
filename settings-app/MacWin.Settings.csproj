<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MacWin.Settings</AssemblyName>
    <RootNamespace>MacWin.Settings</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\MacWin.ico</ApplicationIcon>
    <!-- The repository's VERSION file is the only place the version is written. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\VERSION').Trim())</Version>
    <Product>MacWin</Product>
    <Description>MacWin Settings</Description>
    <Company>IMoggsYou</Company>
    <Authors>IMoggsYou</Authors>
    <Copyright>Copyright (C) 2026 IMoggsYou. Licensed under GPL-3.0-or-later.</Copyright>
    <!-- UI translations are embedded JSON (i18n/*.json), not satellite assemblies. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <!-- Precompiled (ReadyToRun) for a fast first start; still the shared .NET runtime. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI translations, the same files the host and the docs use. -->
    <EmbeddedResource Include="..\i18n\*.json" LogicalName="i18n.%(Filename).json" WithCulture="false" Link="i18n\%(Filename)%(Extension)" />
    <!-- App icons that come with MacWin (imported and given to their programs at start).
         The folder is optional: a build without it simply ships none. -->
    <None Include="..\assets\app-icons\**\*" Link="app-icons\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
