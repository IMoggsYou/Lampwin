<UserControl x:Class="MacWin.Settings.Controls.UpdateSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MacWin.Settings.Controls"
             xmlns:l="clr-namespace:MacWin.Settings"
             Visibility="Collapsed" Focusable="False" KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="Sheet_PreviewKeyDown">
    <!-- A macOS-style sheet: it drops from under the title bar over the dimmed window. -->
    <Grid>
        <Rectangle x:Name="Dim" Fill="Black" Opacity="0"/>
        <Grid x:Name="Sheet" Width="452" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,58,0,0"
              RenderTransformOrigin="0.5,0">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SheetScale"/>
                    <TranslateTransform x:Name="SheetShift"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <!-- The shadow has a layer of its own: on the card, the text would be drawn
                 through the effect and lose its sharpness. -->
            <Border CornerRadius="13" Background="{DynamicResource Brush.WindowBg}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="44" ShadowDepth="14" Direction="270" Opacity="0.28"/>
                </Border.Effect>
            </Border>
            <Border CornerRadius="13" Background="{DynamicResource Brush.WindowBg}"
                    BorderBrush="{DynamicResource Brush.GroupBorder}" BorderThickness="1">
                <StackPanel Margin="22,20,22,18">
                    <DockPanel>
                        <c:AppIcon Width="58" Height="58" VerticalAlignment="Top" Margin="0,0,14,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="Heading" FontFamily="{DynamicResource Font.Display}" FontSize="16"
                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="Subheading" Style="{StaticResource Text.Secondary}" FontSize="12"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- The short summary; it makes room when the full changelog opens (which repeats it). -->
                    <Border x:Name="SummaryBox" Padding="0,16,0,0" ClipToBounds="True">
                        <Border Style="{StaticResource Group}" Margin="0" Padding="14,10,14,11">
                            <StackPanel x:Name="SummaryList"/>
                        </Border>
                    </Border>

                    <DockPanel Margin="2,12,2,0">
                        <TextBlock x:Name="ReleasePage" DockPanel.Dock="Right" Style="{StaticResource LinkText}"
                                   FontSize="12" VerticalAlignment="Center" Text="{l:Tr settings.update.releasePage}"
                                   MouseLeftButtonUp="ReleasePage_Click"/>
                        <ToggleButton x:Name="NotesToggle" Style="{StaticResource DisclosureButton}"
                                      HorizontalAlignment="Left" Checked="NotesToggle_Changed"
                                      Unchecked="NotesToggle_Changed"/>
                    </DockPanel>

                    <Border x:Name="NotesBox" Height="0" Opacity="0" Padding="0,10,0,0" ClipToBounds="True">
                        <Border Style="{StaticResource Group}" Margin="0">
                            <ScrollViewer x:Name="NotesScroller" Style="{StaticResource MacScrollViewer}"
                                          VerticalScrollBarVisibility="Auto" c:SmoothScroll.Enabled="True">
                                <StackPanel x:Name="NotesList" Margin="14,2,14,12"/>
                            </ScrollViewer>
                        </Border>
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="DontShow" Style="{StaticResource MacCheckBox}" VerticalAlignment="Center"
                                  HorizontalAlignment="Left" Margin="0,0,12,0">
                            <TextBlock Text="{l:Tr settings.update.dontShow}" TextWrapping="Wrap"/>
                        </CheckBox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource MacButton}" Margin="0,0,8,0"
                                    Content="{l:Tr settings.update.later}" Click="Later_Click"/>
                            <Button x:Name="InstallButton" Style="{StaticResource MacPrimaryButton}"
                                    Content="{l:Tr settings.update.install}" Click="Install_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
