# Checks the UI translations: cmake -P tools/check_i18n.cmake
# (also run by CTest as "i18n" and in CI). Fails when a language file
#  - is not valid JSON or has a key that en.json does not have (or misses one),
#  - has an empty value,
#  - uses other {n} placeholders than the English text,
# or when an installer language file (installer/languages/*.isl) has other
# [CustomMessages] than English.isl.

cmake_minimum_required(VERSION 3.25)
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(LANGUAGES en pl zh-Hans hi es fr ar bn ru pt-BR ja)
set(errors 0)
list(LENGTH LANGUAGES lang_count)

macro(fail msg)
  message(SEND_ERROR "${msg}")
  math(EXPR errors "${errors} + 1")
endmacro()

function(read_json file out)
  if(NOT EXISTS "${file}")
    message(SEND_ERROR "missing ${file}")
    set(${out} "" PARENT_SCOPE)
    return()
  endif()
  file(READ "${file}" text)
  string(JSON type ERROR_VARIABLE err TYPE "${text}")
  if(err OR NOT type STREQUAL "OBJECT")
    message(SEND_ERROR "${file}: not a JSON object (${err})")
    set(${out} "" PARENT_SCOPE)
    return()
  endif()
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

function(placeholders value out)
  string(REGEX MATCHALL "\\{[0-9]+\\}" found "${value}")
  list(REMOVE_DUPLICATES found)
  list(SORT found)
  set(${out} "${found}" PARENT_SCOPE)
endfunction()

read_json("${ROOT}/i18n/en.json" en)
string(JSON count LENGTH "${en}")
math(EXPR last "${count} - 1")
set(keys "")
foreach(i RANGE ${last})
  string(JSON key MEMBER "${en}" ${i})
  list(APPEND keys "${key}")
endforeach()

foreach(lang IN LISTS LANGUAGES)
  read_json("${ROOT}/i18n/${lang}.json" doc)
  if(doc STREQUAL "")
    math(EXPR errors "${errors} + 1")
    continue()
  endif()
  # Every English key, non-empty, with the same placeholders.
  foreach(key IN LISTS keys)
    string(JSON value ERROR_VARIABLE err GET "${doc}" "${key}")
    if(err)
      fail("i18n/${lang}.json: missing \"${key}\"")
      continue()
    endif()
    string(STRIP "${value}" stripped)
    if(stripped STREQUAL "")
      fail("i18n/${lang}.json: \"${key}\" is empty")
      continue()
    endif()
    string(JSON english GET "${en}" "${key}")
    placeholders("${english}" want)
    placeholders("${value}" have)
    if(NOT "${want}" STREQUAL "${have}")
      fail("i18n/${lang}.json: \"${key}\" has placeholders [${have}], English has [${want}]")
    endif()
  endforeach()
  # No keys English doesn't have.
  string(JSON n LENGTH "${doc}")
  math(EXPR n "${n} - 1")
  foreach(i RANGE ${n})
    string(JSON key MEMBER "${doc}" ${i})
    if(NOT key IN_LIST keys)
      fail("i18n/${lang}.json: unknown key \"${key}\" (not in en.json)")
    endif()
  endforeach()
endforeach()

# Installer: the same [CustomMessages] names in every language file.
function(custom_message_names file out)
  file(STRINGS "${file}" lines ENCODING UTF-8)
  set(names "")
  set(inside FALSE)
  foreach(line IN LISTS lines)
    if(line MATCHES "^\\[([A-Za-z]+)\\]")
      if(CMAKE_MATCH_1 STREQUAL "CustomMessages")
        set(inside TRUE)
      else()
        set(inside FALSE)
      endif()
    elseif(inside AND line MATCHES "^([A-Za-z0-9_]+)=")
      list(APPEND names "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  list(SORT names)
  set(${out} "${names}" PARENT_SCOPE)
endfunction()

set(ISL_DIR "${ROOT}/installer/languages")
if(EXISTS "${ISL_DIR}/English.isl")
  custom_message_names("${ISL_DIR}/English.isl" english_names)
  file(GLOB isl_files "${ISL_DIR}/*.isl")
  list(LENGTH isl_files isl_count)
  if(NOT isl_count EQUAL lang_count)
    fail("installer/languages: ${isl_count} .isl files, expected ${lang_count}")
  endif()
  foreach(f IN LISTS isl_files)
    custom_message_names("${f}" names)
    if(NOT "${names}" STREQUAL "${english_names}")
      get_filename_component(name "${f}" NAME)
      fail("installer/languages/${name}: [CustomMessages] differ from English.isl")
    endif()
  endforeach()
endif()

if(errors GREATER 0)
  message(FATAL_ERROR "i18n check failed: ${errors} problem(s)")
endif()
list(LENGTH keys key_count)
message(STATUS "i18n OK: ${key_count} keys in ${lang_count} languages")
