<Project Sdk="Microsoft.NET.Sdk">

  <!-- Turns the icons in assets/app-icons into the compact 256 px PNGs that ship with the
       app (see README.md here). Uses the settings app's own conversion. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Compile Include="..\..\settings-app\Services\IconImport.cs" Link="IconImport.cs" />
  </ItemGroup>

</Project>
